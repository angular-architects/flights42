{
  "name": "flights42",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.6",
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@hashbrownai/angular": "^0.5.0",
    "@hashbrownai/core": "^0.5.0",
    "@hashbrownai/google": "^0.5.0",
    "@hashbrownai/openai": "^0.5.0",
    "@ngrx/operators": "^22.0.0-beta.0",
    "@ngrx/signals": "^22.0.0-beta.0",
    "@softarc/native-federation-node": "^3.3.4",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "es-module-shims": "^1.5.12",
    "express": "^5.2.1",
    "marked": "^18.0.7",
    "ngx-markdown": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@softarc/detective": "^2.1.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.1.0",
    "commitlint": "^21.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "ng-packagr": "^22.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsarch": "^5.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@angular/core": "$@angular/core",
    "@angular/common": "$@angular/common",
    "@angular/build": "$@angular/build",
    "@angular/platform-browser": "$@angular/platform-browser",
    "@ngrx/signals": "$@ngrx/signals",
    "eslint": "$eslint",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@softarc/detective": {
      "express": "^4.22.2"
    },
    "@hono/node-server": "^2.0.12"
  }
}
