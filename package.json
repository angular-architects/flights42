{
  "name": "flights42",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:arch": "vitest run --config vitest.arch.config.ts",
    "verify": "node scripts/verify.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json,md}\"",
    "sync:agent-config": "node scripts/sync-agent-config.mjs",
    "prepare": "husky && npm run sync:agent-config",
    "tickets": "node scripts/run-tickets.mts"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular-architects/native-federation": "^22.1.3",
    "@angular-architects/ngrx-toolkit": "^22.0.0",
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@hashbrownai/angular": "^0.5.0",
    "@hashbrownai/core": "^0.5.0",
    "@hashbrownai/google": "^0.5.0",
    "@hashbrownai/openai": "^0.5.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "marked": "^18.0.13",
    "ngx-markdown": "^22.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@commitlint/config-conventional": "^21.2.2",
    "@softarc/detective": "^2.1.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "archunit": "^2.5.4",
    "commitlint": "^21.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "ng-packagr": "^22.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hashbrownai/angular": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common"
    }
  }
}
