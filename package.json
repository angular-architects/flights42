{
  "name": "flights42",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "ai-server": "mastra dev --dir ai-server/src/mastra",
    "ai-server:build": "mastra build --dir ai-server/src/mastra",
    "ai-server:start": "mastra start --dir ai-server/src/mastra",
    "mcp-server": "concurrently \"npm run mcp-server:app:watch\" \"tsx watch mcp-server/src/server.ts\"",
    "mcp-server:app:build": "vite build --config mcp-server/vite.config.ts",
    "mcp-server:app:watch": "vite build --config mcp-server/vite.config.ts --watch",
    "mcp-server:start": "npm run mcp-server:app:build && tsx mcp-server/src/server.ts",
    "agent": "npm run ai-server",
    "agent:build": "npm run ai-server:build",
    "agent:start": "npm run ai-server:start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:aimock": "ng run flights:test-node",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json,md}\"",
    "ai-demo-server": "mastra dev --dir ai-demo/server",
    "ai-demo-client": "node --watch --import tsx ai-demo/client/index.ts",
    "ai-demo-client:details": "node --watch --import tsx ai-demo/client/index.ts --details",
    "simple-client": "ng serve simple-client",
    "mcp-apps-demo": "vite --config mcp-apps-demo/vite.config.ts --open /host.html",
    "mcp-apps-demo:build": "vite build --config mcp-apps-demo/vite.config.ts",
    "voice-demo": "vite voice-demo",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "overrides": {
    "rxjs": "$rxjs",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@softarc/detective": {
      "express": "^4.21.2",
      "path-to-regexp": "^0.1.12",
      "cookie": "^0.7.2",
      "qs": "^6.15.2"
    },
    "@angular-architects/ngrx-toolkit": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@ngrx/signals": "$@ngrx/signals",
      "@ngrx/store": "^22.0.0"
    },
    "@a2ui/angular": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/platform-browser": "$@angular/platform-browser"
    },
    "@ag-ui/mastra": {
      "@copilotkit/runtime": "npm:empty-npm-package@1"
    }
  },
  "dependencies": {
    "@a2ui/angular": "^0.10.4",
    "@a2ui/web_core": "^0.10.5",
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/mastra": "1.0.0",
    "@ag-ui/mcp-apps-middleware": "0.0.3",
    "@angular-architects/native-federation": "^22.1.2",
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@copilotkit/angular": "0.4.0",
    "@mastra/client-js": "^1.42.4",
    "@mastra/core": "^1.63.2",
    "@mastra/libsql": "^1.22.2",
    "@mastra/loggers": "^1.3.0",
    "@mastra/mcp": "^1.17.2",
    "@mastra/memory": "^1.28.1",
    "@mastra/observability": "^1.17.4",
    "@modelcontextprotocol/ext-apps": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "jsonata": "^2.1.0",
    "marked": "^17.0.1",
    "ngx-markdown": "^22.0.0",
    "quickjs-emscripten": "^0.32.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@commitlint/config-conventional": "^20.2.0",
    "@copilotkit/aimock": "^1.37.4",
    "@copilotkit/core": "^1.69.3",
    "@softarc/detective": "^2.0.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "22.1.0",
    "commitlint": "^20.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.7",
    "mastra": "^1.27.2",
    "ng-packagr": "^22.1.1",
    "playwright": "^1.58.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.0.8"
  }
}
